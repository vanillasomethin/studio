    "build:android": "node -e \"if(!require('fs').existsSync('google-services.json')){console.error('google-services.json missing — push notifications will be silently dead in this build. See DEPLOYMENT.md § Push notifications.');process.exit(1)}\" && eas build --platform android"
  },
