{
  "expo": {
    "name": "ALIVE Store",
    "slug": "alive-store",
    "owner": "vs-collective-llp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f9fafb",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#ef4444",
      "resizeMode": "cover"
    },
    "android": {
      "package": "in.wearealive.store",
      "googleServicesFile": "./google-services.json",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ef4444"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "scheme": "alive-store",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c71c9af8-9f0f-479e-b267-8a767b053692"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ALIVE Store to use your location to place your shop on the ALIVE network map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ALIVE Store to access your photos for KYC and flyer uploads.",
          "cameraPermission": "Allow ALIVE Store to use the camera for your KYC selfie.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ef4444",
          "defaultChannel": "alerts"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c71c9af8-9f0f-479e-b267-8a767b053692"
      }
    }
  }
}
